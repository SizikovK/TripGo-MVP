HTTP_ADDR=:8080
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=10s
DATABASE_URL=postgres://tripgo:tripgo@localhost:22032/tripgo?sslmode=disable
DATABASE_MAX_CONNS=10
DATABASE_MIN_CONNS=2
DATABASE_MAX_CONN_LIFETIME=30m
DATABASE_CONNECT_TIMEOUT=5s
DATABASE_QUERY_TIMEOUT=3s
HTTP_READ_TIMEOUT=10s
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
OTEL_SERVICE_NAME=trip-service
SERVICE_VERSION=local
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:22317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_TRACES_SAMPLER=parentbased_always_on
OTEL_TRACES_SAMPLER_ARG=1
OTEL_METRIC_EXPORT_INTERVAL=5000
OTEL_RESOURCE_ATTRIBUTES=service.namespace=tripgo,deployment.environment=local
DOCKER_DATABASE_URL=postgres://tripgo:tripgo@host.docker.internal:22032/tripgo?sslmode=disable
DOCKER_OTEL_EXPORTER_OTLP_ENDPOINT=http://host.docker.internal:22317
